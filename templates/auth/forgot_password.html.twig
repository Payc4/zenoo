{% extends 'base.html.twig' %}

{% block title %}Forgot your password? · ZENOO{% endblock %}

{% block body %}
<section class="auth-page">
    <div class="wrap">
        <div class="auth-card">
            <h1>Forgot your password?</h1>
            <p class="lead">Enter your email and we’ll send you a link to choose a new one.</p>
            <form method="post">
                <div class="field">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" autocomplete="email" required autofocus>
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('forgot-password') }}">
                <button class="btn btn-block" type="submit">Send reset link</button>
            </form>
            <p class="auth-alt"><a href="{{ path('app_login') }}">Back to log in</a></p>
        </div>
    </div>
</section>
{% endblock %}
