{% extends 'base.html.twig' %}

{% block title %}{{ 'Choose a new password'|trans }} · ZENOO{% endblock %}
{% block robots %}<meta name="robots" content="noindex"><meta name="referrer" content="no-referrer">{% endblock %}

{% block body %}
<section class="auth-page">
    <div class="wrap">
        <div class="auth-card">
            <h1>{{ 'Choose a new password'|trans }}</h1>
            <p class="lead">{{ 'At least 8 characters.'|trans }}</p>
            {% if error %}<div class="form-errors" role="alert">{{ error|trans }}</div>{% endif %}
            <form method="post">
                <div class="field">
                    <label for="password">{{ 'New password'|trans }}</label>
                    <input type="password" id="password" name="password" autocomplete="new-password" minlength="8" required autofocus>
                </div>
                <div class="field">
                    <label for="password_confirm">{{ 'Repeat new password'|trans }}</label>
                    <input type="password" id="password_confirm" name="password_confirm" autocomplete="new-password" minlength="8" required>
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('reset-password') }}">
                <button class="btn btn-block" type="submit">{{ 'Save new password'|trans }}</button>
            </form>
        </div>
    </div>
</section>
{% endblock %}
