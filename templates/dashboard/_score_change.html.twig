{# The Bowl Score was worked out again after a new weight or body shape (App\Quiz\ScoreRecalculator).
   Shown on Today and the dog's tab until the owner closes it. back: where closing returns to. #}
{% set c = dog.scoreChange %}
{% if c %}
  {% set diff = c.to - c.from %}
  {% set why = c.why|join('+') %}
  <div class="score-change{{ diff > 0 ? ' is-up' : (diff < 0 ? ' is-down' : '') }}" role="status">
    <span class="score-change__icon" aria-hidden="true">{{ diff > 0 ? '▲' : (diff < 0 ? '▼' : '•') }}</span>
    <div class="score-change__text">
      <p class="score-change__title">
        {% if diff != 0 %}
          {{ 'Bowl Score updated: %from% → %to% (%diff%)'|trans({'%from%': c.from, '%to%': c.to, '%diff%': (diff > 0 ? '+' : '−') ~ diff|abs}) }}
        {% else %}
          {{ 'Daily plan updated'|trans }}
        {% endif %}
      </p>
      <p>
        {% if 'weight' in why and 'body' in why %}{{ 'Worked out again after %dog%’s new weight and body shape.'|trans({'%dog%': dog.name}) }}
        {% elseif 'body' in why %}{{ 'Worked out again after %dog%’s new body shape.'|trans({'%dog%': dog.name}) }}
        {% else %}{{ 'Worked out again after %dog%’s new weight.'|trans({'%dog%': dog.name}) }}{% endif %}
        {% if c.plan_to and c.plan_to != c.plan_from %}
          {{ 'Daily food: %plan%'|trans({'%plan%': c.plan_to}) }}{% if c.plan_from %} <span class="score-change__was">({{ 'was: %plan%'|trans({'%plan%': c.plan_from}) }})</span>{% endif %}
        {% endif %}
      </p>
    </div>
    <form method="post" action="{{ path('app_score_change_close') }}">
      <input type="hidden" name="_token" value="{{ csrf_token('score-change') }}">
      <input type="hidden" name="back" value="{{ back|default('today') }}">
      <button type="submit" class="score-change__close" aria-label="{{ 'Close'|trans }}">×</button>
    </form>
  </div>
{% endif %}
