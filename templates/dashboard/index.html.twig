{% extends 'base.html.twig' %}
{% import 'dashboard/_shapes.html.twig' as shapes %}

{#
  "Today" (test report proposal 2): one next step with the screen's only orange button, today's
  bowl, the log, and the coach, in about a screen and a half. Everything occasional about the dog
  (score history, plan, trends, notes, vet report, sharing, removal) is on its own tab.
#}
{% block title %}{{ dog ? 'Today for %dog%'|trans({'%dog%': dog.name}) : 'My dog'|trans }} · ZENOO{% endblock %}
{% block robots %}<meta name="robots" content="noindex">{% endblock %}
{% block importmap %}{{ importmap(['app', 'dashboard']) }}{% endblock %}

{% set trackers = {
  weight: {label: 'Weight'|trans, help: 'Weigh on the same scale, at the same time of day.'|trans},
  body: {label: 'Body shape'|trans, help: 'Ideal: ribs easy to feel, a waist seen from above.'|trans},
  stool: {label: 'Stool'|trans, help: '2 is ideal: firm, segmented, easy to pick up. 7 is watery.'|trans},
  itch: {label: 'Itching'|trans, help: '0 is none, 10 is scratching all the time.'|trans},
} %}
{% set bodyNames = {1: 'Too thin', 2: 'Too thin', 3: 'Thin', 4: 'Thin', 5: 'Ideal', 6: 'Heavy', 7: 'Heavy', 8: 'Too heavy', 9: 'Too heavy'} %}

{% block body %}
<section class="today-head">
  <div class="wrap">
    <p class="kicker">{{ date()|local_date('long') }}</p>
    <h1>{{ dog ? 'Today for %dog%'|trans({'%dog%': dog.name}) : 'Welcome to ZENOO'|trans }}</h1>
    {% if dog %}
      <a class="today-score" href="{{ path('app_dog_tab') }}#score-h">
        <span class="today-score__ring" style="--p: {{ dog.bowlScore }}"><span>{{ dog.bowlScore }}</span></span>
        <span><strong>{{ 'Bowl Score'|trans }}{% if dog.get('score_title') %}: {{ dog_text(dog, 'score_title')|lower }}{% endif %}</strong><br><u>{{ 'See the breakdown'|trans }}</u></span>
      </a>
    {% endif %}
  </div>
</section>

<div class="wrap today">
  {% if dog %}{{ include('dashboard/_score_change.html.twig', {back: 'today'}) }}{% endif %}
  {% if not user.hasPassword %}
    <p class="today-notice">{{ 'Choose a password so you can sign in any time.'|trans }} <a href="{{ path('app_account') }}#password">{{ 'Choose a password'|trans }}</a></p>
  {% endif %}

  {# 1. One next step: the only orange button on the screen. #}
  {% if nextStep %}
    {% set p = nextStep.params ?? {} %}
    <section class="card today-next" aria-labelledby="next-h">
      <p class="kicker">{{ 'Next step'|trans }}</p>
      {% if nextStep.kind == 'lesson' %}
        <h2 id="next-h">{{ 'Lesson %n%: %title%'|trans({'%n%': nextStep.lesson.number, '%title%': nextStep.title}) }}</h2>
        <p class="muted">{% if nextStep.lesson.lesson.durationMinutes %}{{ '%n% minutes'|trans({'%n%': nextStep.lesson.lesson.durationMinutes}) }} · {% endif %}{{ '%done% of %total% lessons done'|trans({'%done%': done, '%total%': total}) }}</p>
      {% else %}
        <h2 id="next-h">{{ nextStep.title|trans(p) }}</h2>
        {% if nextStep.text %}<p>{{ nextStep.kind == 'checkin' ? nextStep.text : nextStep.text|trans(p) }}</p>{% endif %}
      {% endif %}
      {% if nextStep.url starts with '#log-' %}
        <button class="btn btn-block" type="button" data-log-open="{{ nextStep.url|slice(5) }}">{{ nextStep.cta|trans(p) }}</button>
      {% else %}
        <a class="btn btn-block" href="{{ nextStep.url }}">{{ nextStep.cta|trans(p) }}</a>
      {% endif %}
    </section>
  {% endif %}

  {% if dog %}
    {# 2. Today's bowl: the plan's key numbers; the full plan is on the dog's tab. #}
    <section class="card card-mist today-bowl" aria-labelledby="bowl-h">
      <div class="today-row">
        <p class="kicker" id="bowl-h">{{ 'Today’s bowl'|trans }}</p>
        <a href="{{ path('app_dog_tab') }}#plan-h">{{ 'Full plan'|trans }}</a>
      </div>
      {% if dog_text(dog, 'plan_food') %}
        {# The amounts big; a "keep today's amounts / ask your vet" note (after " — ") small. #}
        {% set parts = dog_text(dog, 'plan_food')|split(' — ', 2) %}
        <p class="today-bowl__food">{{ parts[0] }}</p>
        {% if parts[1] is defined %}<p class="today-bowl__note">{{ parts[1] }}</p>{% endif %}
      {% endif %}
      <p class="muted">{{ [dog_text(dog, 'plan_meals'), include('dashboard/_kcal.html.twig')|trim]|filter(x => x)|join(' · ') }}</p>
    </section>

    {# 3. The log: last values at a glance, one "Add entry", Undo on the newest entry. #}
    <section class="card today-log" id="log" aria-labelledby="log-h">
      <div class="today-row">
        <h2 id="log-h">{{ '%dog%’s log'|trans({'%dog%': dog.name}) }}</h2>
        <button class="btn btn-outline btn-small" type="button" data-log-open="weight">+ {{ 'Add entry'|trans }}</button>
      </div>
      <div class="today-tiles">
        {% for type, t in trackers %}
          {% set last = dog.latestLog(type) %}
          <div class="today-tile{{ logged == type ? ' is-new' }}">
            <span class="today-tile__label">{{ t.label }}</span>
            {% if last %}
              <strong>{% if type == 'weight' %}{{ last.v|replace({'.': decimal_sep()}) }} kg{% elseif type == 'body' %}{{ bodyNames[last.v]|trans }}{% elseif type == 'stool' %}{{ '%n% of 7'|trans({'%n%': last.v}) }}{% else %}{{ '%n% of 10'|trans({'%n%': last.v}) }}{% endif %}</strong>
              {% if logged == type %}
                <form method="post" action="{{ path('app_dog_tracker_undo') }}" class="today-undo">
                  <input type="hidden" name="_token" value="{{ csrf_token('tracker') }}"><input type="hidden" name="type" value="{{ type }}"><input type="hidden" name="date" value="{{ loggedDay }}">
                  <span>{{ 'Saved just now'|trans }}{% if loggedDay and loggedDay != 'now'|date('Y-m-d') %} ({{ date(loggedDay)|local_date('day') }}){% endif %} ·</span> <button type="submit">{{ 'Undo'|trans }}</button>
                </form>
              {% else %}
                <span class="muted">{{ date(last.d)|local_date('day') }}</span>
              {% endif %}
            {% else %}
              <strong>–</strong><span class="muted">{{ 'Not logged yet'|trans }}</span>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </section>

    {# One sheet for all four logs. Nothing is pre-selected. #}
    <dialog class="log-sheet" id="log-sheet" aria-labelledby="sheet-h">
      <div class="today-row">
        <h2 id="sheet-h">{{ 'Log for %dog%'|trans({'%dog%': dog.name}) }}</h2>
        <form method="dialog"><button class="log-sheet__close" aria-label="{{ 'Close'|trans }}">×</button></form>
      </div>
      <div class="log-tabs" role="tablist">
        {% for type, t in trackers %}<button type="button" role="tab" data-log-tab="{{ type }}" aria-selected="false">{{ t.label }}</button>{% endfor %}
      </div>
      {% for type, t in trackers %}
        <form method="post" action="{{ path('app_dog_tracker') }}" class="log-panel" data-log-panel="{{ type }}" hidden>
          <input type="hidden" name="_token" value="{{ csrf_token('tracker') }}"><input type="hidden" name="type" value="{{ type }}">
          {# Weighed yesterday, written down today: the owner picks the day (up to a year back). #}
          <label class="log-date">{{ 'Date'|trans }}
            <input type="date" name="date" value="{{ 'now'|date('Y-m-d') }}" max="{{ 'now'|date('Y-m-d') }}" min="{{ '-1 year'|date('Y-m-d') }}" required>
          </label>
          {% if type == 'weight' %}
            <label for="log-weight-v">{{ 'What does %dog% weigh?'|trans({'%dog%': dog.name}) }}</label>
            <div class="log-weight"><input id="log-weight-v" name="value" inputmode="decimal" required placeholder="{{ (dog.latestLog('weight').v ?? '')|replace({'.': decimal_sep()}) }}"><span>kg</span></div>
          {% elseif type == 'body' %}
            <p class="log-q">{{ 'Which shape is closest to %dog%, seen from above?'|trans({'%dog%': dog.name}) }}</p>
            <div class="log-shapes">
              {% for o in [{v: 2, l: 'Too thin', s: [10, 3.5, 7]}, {v: 4, l: 'Thin', s: [11, 6, 8.5]}, {v: 5, l: 'Ideal', s: [12, 8, 10]}, {v: 7, l: 'Heavy', s: [13, 14, 12]}, {v: 8, l: 'Too heavy', s: [14, 18.5, 14.5]}] %}
                <label class="log-shape"><input type="radio" name="value" value="{{ o.v }}" required>{{ shapes.shape(o.s[0], o.s[1], o.s[2]) }}<span>{{ o.l|trans }}</span></label>
              {% endfor %}
            </div>
          {% else %}
            <p class="log-q">{{ type == 'stool' ? 'How was %dog%’s stool today? (1 hard, 2 ideal, 7 watery)'|trans({'%dog%': dog.name}) : 'How much is %dog% scratching? (0 not at all, 10 all the time)'|trans({'%dog%': dog.name}) }}</p>
            <div class="log-scale">
              {% for v in (type == 'stool' ? 1..7 : 0..10) %}<label><input type="radio" name="value" value="{{ v }}" required><span>{{ v }}</span></label>{% endfor %}
            </div>
          {% endif %}
          <p class="small muted">{{ t.help }}</p>
          <button class="btn btn-block" type="submit">{{ 'Save %what%'|trans({'%what%': t.label|lower}) }}</button>
        </form>
      {% endfor %}
    </dialog>
  {% endif %}

  {# 4. The coach, within one scroll. #}
  <section class="card card-forest today-coach" aria-labelledby="coach-h">
    <p class="kicker" id="coach-h">{{ 'Coach'|trans }}</p>
    <form action="{{ path('app_chat') }}" method="get" class="today-ask">
      <label class="visually-hidden" for="today-ask">{{ 'Ask the coach'|trans }}</label>
      <input id="today-ask" name="ask" required placeholder="{{ dog ? 'Ask about %dog%…'|trans({'%dog%': dog.name}) : 'Ask the coach…'|trans }}">
      <button type="submit" aria-label="{{ 'Send'|trans }}">↑</button>
    </form>
    <div class="today-chips">
      {% for q in coachQuestions|slice(0, 2) %}
        {% set text = q|trans({'%dog%': dog.name}) %}
        <a class="dash-chip" href="{{ path('app_chat', {ask: text}) }}">{{ text }}</a>
      {% endfor %}
    </div>
  </section>
</div>
{% endblock %}
