{#
  The Bowl Score quiz from the ZENOO handoff (prototype/quiz). scoring.js and styles.css in
  public/quiz/ are the handoff files as they were; app.js gained the quiz → account step and
  reads all its wording from content.<locale>.js (English or Lithuanian). This page shell
  links the logo back to the site and passes the market config from HomeController::quiz().
#}
<!doctype html>
<html lang="{{ locale }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ 'Is your dog eating properly?'|trans }} · ZENOO Bowl Score</title>
  <meta name="theme-color" content="#445942">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" href="/favicon.png" type="image/png">
  <link rel="stylesheet" href="/quiz/styles.css">
  <link rel="stylesheet" href="/quiz/site.css">
  {% if not app.debug %}<style>.zq-demo { display: none; }</style>{% endif %}
</head>
<body>
  <header class="zq-header"><a href="{{ path('app_homepage') }}"><img src="/quiz/assets/logo-white.png" alt="{{ 'ZENOO home'|trans }}"></a></header>
  <div class="zq-progress" aria-hidden="true"><div id="zq-progress" style="width:0"></div></div>
  <main id="zq-app" aria-live="polite"></main>
  <footer class="zq-footer"><img src="/quiz/assets/logo-forest.png" alt="ZENOO">{{ 'Real Food. Healthy Pet.'|trans }}</footer>

  <script>
    // Market config from HomeController::quiz(): language, Klaviyo account, quiz → account.
    window.ZQ_CONFIG = {{ quizConfig|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_UNESCAPED_SLASHES'))|raw }};
  </script>
  <script src="/quiz/scoring.js"></script>
  <script src="/quiz/content.{{ locale }}.js"></script>
  <script src="/quiz/app.js"></script>
</body>
</html>
