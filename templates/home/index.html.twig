{% extends 'base.html.twig' %}

{# Home (test report proposal 7): the headline names what a visitor gets, one action, and a
   preview of the result in place of a stock photo. #}
{% block description %}{{ 'A free 3-minute check of your dog’s bowl, body and day, with a Bowl Score and a daily plan.'|trans }}{% endblock %}
{% block head %}{{ include('_og.html.twig', {og_title: 'Find out if your dog is eating properly'|trans, og_description: 'A free 3-minute check of your dog’s bowl, body and day, with a Bowl Score and a daily plan.'|trans}) }}{% endblock %}

{% block body %}
<section class="hero">
    <div class="wrap">
        <div>
            <p class="kicker">{{ 'Free · about 3 minutes'|trans }}</p>
            <h1>{{ 'Find out if your dog is eating properly'|trans }}</h1>
            <p class="lead">{{ 'Answer a few questions and get a Bowl Score out of 100, how many grams to feed a day, and the first three things to change.'|trans }}</p>
            <div class="btn-row">
                <a class="btn" href="{{ path('app_quiz') }}">{{ 'Get your dog’s Bowl Score'|trans }}</a>
            </div>
            {% if not app.user %}<p class="hero-signin">{{ 'Already have an account?'|trans }} <a href="{{ path('app_login') }}">{{ 'Sign in'|trans }}</a></p>{% endif %}
        </div>
        <figure class="hero-result" aria-label="{{ 'An example result'|trans }}">
            <div class="hero-result__score">
                <span class="hero-result__label">{{ 'Example: Bella’s Bowl Score'|trans }}</span>
                <strong>72<small>/100</small></strong>
                <span>{{ 'Good, with room to grow'|trans }}</span>
            </div>
            <div class="hero-result__body">
                <p class="hero-result__title">{{ 'What we’d do first'|trans }}</p>
                <ol>
                    <li>{{ 'Weigh her food: about 290 g a day, in two meals'|trans }}</li>
                    <li>{{ 'Swap part of the bowl for fresher, meat-rich food'|trans }}</li>
                    <li>{{ 'Add a 15-minute sniff walk'|trans }}</li>
                </ol>
            </div>
        </figure>
    </div>
</section>

<section class="section">
    <div class="wrap">
        <p class="kicker">{{ 'How it works'|trans }}</p>
        <h2>{{ 'Three simple steps'|trans }}</h2>
        <div class="grid grid-3" style="margin-top:24px">
            <div class="card">
                <span class="feature-num">01</span>
                <h3>{{ 'Take the check'|trans }}</h3>
                <p>{{ 'Breed, age, weight, body shape, activity and food: about 3 minutes, no right or wrong answers.'|trans }}</p>
            </div>
            <div class="card">
                <span class="feature-num">02</span>
                <h3>{{ 'Get your dog’s plan'|trans }}</h3>
                <p>{{ 'A Bowl Score out of 100, grams a day for your dog, and the first three things to try.'|trans }}</p>
            </div>
            <div class="card">
                <span class="feature-num">03</span>
                <h3>{{ 'Keep it going'|trans }}</h3>
                <p>{{ 'A coach that knows your dog, short lessons, and a log for weight, stool and itching. All free.'|trans }}</p>
            </div>
        </div>
        <p style="margin-top:28px"><a class="btn btn-outline" href="{{ path('app_quiz') }}">{{ 'Start the check'|trans }}</a></p>
    </div>
</section>
{% endblock %}
