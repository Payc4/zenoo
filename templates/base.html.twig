<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}ZENOO · Real Food. Healthy Pet.{% endblock %}</title>
    <meta name="description" content="{% block description %}Your ZENOO account: take the Bowl Score quiz, shop and keep your orders in one place.{% endblock %}">
    <meta name="theme-color" content="#445942">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/favicon.png" type="image/png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    {% block robots %}{% endblock %}
    {% block importmap %}{{ importmap('app') }}{% endblock %}
</head>
<body class="{% block body_class %}{% endblock %}">
    <a class="skip" href="#main">Skip to content</a>

    {% set route = app.request.attributes.get('_route') %}
    <header class="site-header">
        <div class="wrap">
            <a class="brand" href="{{ path('app_homepage') }}"><img src="/images/logo-white.png" alt="ZENOO home" width="94" height="26"></a>
            <button class="nav-toggle" type="button" aria-controls="site-nav" aria-expanded="false">
                <span class="visually-hidden">Menu</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
            </button>
            <nav class="nav" id="site-nav" aria-label="Main">
                <a href="{{ path('app_shop') }}" {{ route starts with 'app_shop' or route == 'app_product' ? 'aria-current="page"' }}>Shop</a>
                <a href="{{ path('app_quiz') }}">Bowl Score quiz</a>
                <a href="{{ path('app_chat') }}" {{ route starts with 'app_chat' ? 'aria-current="page"' }}>Chat</a>
                {% if app.user %}
                    {% if is_granted('ROLE_ADMIN') %}<a href="{{ path('admin') }}">Admin</a>{% endif %}
                    <a class="nav-avatar" href="{{ path('app_account') }}" {{ route starts with 'app_account' ? 'aria-current="page"' }}>
                        {{ include('account/_avatar.html.twig', {user: app.user, size: 'sm'}) }} My account
                    </a>
                    <a href="{{ path('app_logout') }}">Log out</a>
                {% else %}
                    <a href="{{ path('app_login') }}" {{ route == 'app_login' ? 'aria-current="page"' }}>Log in</a>
                    <a class="btn btn-small" href="{{ path('app_register') }}">Create account</a>
                {% endif %}
            </nav>
        </div>
    </header>

    <main id="main">
        {% set flashes = app.flashes %}
        {% if flashes|length %}
            <div class="wrap flashes" role="status">
                {% for type, messages in flashes %}
                    {% for message in messages %}
                        <div class="flash flash-{{ type in ['success', 'error'] ? type : 'info' }}">{{ message }}</div>
                    {% endfor %}
                {% endfor %}
            </div>
        {% endif %}

        {% block body %}{% endblock %}
    </main>

    {% block footer %}
    <footer class="site-footer">
        <div class="wrap">
            <div>
                <img src="/images/logo-white.png" alt="ZENOO" width="80" height="22">
                <p class="tagline">Real Food. Healthy Pet.</p>
            </div>
            <nav aria-label="Footer">
                <a href="{{ path('app_shop') }}">Shop</a>
                <a href="{{ path('app_quiz') }}">Bowl Score quiz</a>
                <a href="{{ path('app_privacy_policy') }}">Privacy policy</a>
                <a href="https://myzenoo.com">myzenoo.com</a>
            </nav>
        </div>
    </footer>
    {% endblock %}
</body>
</html>
