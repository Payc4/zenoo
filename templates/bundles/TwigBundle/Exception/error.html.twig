{% extends 'base.html.twig' %}
{% block title %}Something went wrong · ZENOO{% endblock %}
{% block body %}
<section class="error-page">
    <div class="wrap">
        <div class="code">{{ status_code }}</div>
        <h1>Something went wrong</h1>
        <p class="lead" style="margin:0 auto 24px">Sorry about that. Please try again in a moment.</p>
        <a class="btn" href="{{ path('app_homepage') }}">Go to the home page</a>
    </div>
</section>
{% endblock %}
