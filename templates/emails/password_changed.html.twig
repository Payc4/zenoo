{% extends 'emails/_layout.html.twig' %}
{% import 'emails/_ui.html.twig' as ui %}
{% block title %}{{ 'Your password was changed'|trans }}{% endblock %}
{% block content %}
{{ ui.eyebrow('My account'|trans) }}
{{ ui.h1('Password changed'|trans) }}
{{ ui.p('Hi %name%, the password for your ZENOO account was just changed.'|trans({'%name%': user.displayName})) }}
{{ ui.p('If that was you, there’s nothing else to do. If it wasn’t, reset it now and write to support@myzenoo.com.'|trans) }}
{{ ui.button(appUrl ~ '/forgot-password', 'Reset my password'|trans) }}
{% endblock %}
