{% extends 'emails/_layout.html.twig' %}
{% block title %}{{ 'Your password was changed'|trans }}{% endblock %}
{% block content %}
<h1 style="font-family:'Inter Tight',Inter,Helvetica,Arial,sans-serif;font-weight:800;font-size:26px;line-height:1.15;text-transform:uppercase;margin:0 0 14px;color:#445942;">{{ 'Password changed'|trans }}</h1>
<p style="margin:0 0 12px;">{{ 'Hi %name%, the password for your ZENOO account was just changed.'|trans({'%name%': user.displayName}) }}</p>
<p style="margin:0 0 12px;">{{ 'If that was you, there’s nothing else to do. If it wasn’t, reset it now and write to support@myzenoo.com.'|trans }}</p>
{{ include('emails/_button.html.twig', {url: appUrl ~ '/forgot-password', label: 'Reset my password'|trans}) }}
{% endblock %}
