{% extends 'emails/_layout.html.twig' %}
{% import 'emails/_ui.html.twig' as ui %}
{# Roadmap 04: the tips series (PlanEmails, day 3, 7 and 14). content holds [message, params] pairs. #}
{% macro t(line) %}{{ line is iterable ? line[0]|trans(line[1]) : line|trans }}{% endmacro %}
{% block title %}{{ _self.t(content.heading) }}{% endblock %}
{% block content %}
{{ ui.eyebrow(dogName) }}
{{ ui.h1(_self.t(content.heading)) }}
{{ ui.p(user.firstName ? 'Hi %name%,'|trans({'%name%': user.firstName}) : 'Hi,'|trans) }}
{{ ui.p(_self.t(content.text)) }}
{{ ui.button(buttonUrl, _self.t(content.button)) }}
{% endblock %}
{% block unsubscribe %}<p style="margin:6px 0 0;"><a href="{{ offUrl }}" style="color:#ffffff;text-decoration:underline;">{{ 'Don’t want these emails? Unsubscribe'|trans }}</a></p>{% endblock %}
