{# Shared email layout, after the "ZENOO Email Template" design: green bar with the white logo, white
   600 px body, optional full-width cream band, Agota's text signature and the green footer. Tables and inline
   styles only, so it renders in Gmail, Outlook and Apple Mail. Blocks: content (top), band (cream,
   full width), after (below the band), unsubscribe (a line in the footer). #}
{% import 'emails/_ui.html.twig' as ui %}
{% set font = 'font-family:Inter,Arial,Helvetica,sans-serif;' %}
{% set site = appUrl|replace({'https://': '', 'http://': ''}) %}
<!DOCTYPE html>
<html lang="{{ app.locale }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="x-apple-disable-message-reformatting">
<meta name="color-scheme" content="light">
<meta name="supported-color-schemes" content="light">
<title>{% block title %}ZENOO{% endblock %}</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;800&amp;display=swap" rel="stylesheet">
<style>
body{margin:0;padding:0;}
a{color:#445942;}
@media (max-width:620px){.zx-pad{padding-left:16px!important;padding-right:16px!important;}}
</style>
</head>
<body style="margin:0;padding:0;background:#e9ebe6;{{ font }}color:#5a6b59;-webkit-font-smoothing:antialiased;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#e9ebe6" style="background:#e9ebe6;">
<tr><td align="center" style="padding:24px 0;">
  <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" bgcolor="#ffffff" style="width:100%;max-width:600px;background:#ffffff;">
    {# Header #}
    <tr><td align="center" bgcolor="#445942" style="background:#445942;height:84px;padding:0 20px;">
      <a href="{{ appUrl }}" style="display:inline-block;"><img src="{{ appUrl }}/images/logo-white.png" width="140" alt="ZENOO" style="display:block;border:0;width:140px;height:auto;"></a>
    </td></tr>
    {# Body #}
    <tr><td class="zx-pad" style="padding:40px 20px 10px;">
      {% block content %}{% endblock %}
    </td></tr>
    {% if block('band') is defined and block('band')|trim %}
    <tr><td class="zx-pad" bgcolor="#f8f7f2" style="background:#f8f7f2;padding:30px 20px;">
      {{ block('band') }}
    </td></tr>
    <tr><td class="zx-pad" style="padding:30px 20px 0;">
      {% block after %}{% endblock %}
    </td></tr>
    {% endif %}
    {# Signature (text only) #}
    <tr><td class="zx-pad" style="padding:20px 20px 40px;">
      {{ ui.p('Warm regards,'|trans, true) }}
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:10px;"><tr><td style="border-top:1px solid #dde5dc;padding-top:10px;">
        <p style="margin:0;{{ font }}font-size:20px;line-height:26px;font-weight:800;color:#445942;">Agota</p>
        <p style="margin:2px 0 0;{{ font }}font-size:14px;line-height:20px;color:#5f6e5e;">{{ 'ZENOO founder and dog nutrition specialist'|trans }}</p>
      </td></tr></table>
    </td></tr>
    {# Footer #}
    <tr><td class="zx-pad" bgcolor="#445942" style="background:#445942;padding:40px 20px 20px;{{ font }}color:#ffffff;">
      <a href="{{ appUrl }}" style="display:inline-block;"><img src="{{ appUrl }}/images/logo-white.png" width="110" alt="ZENOO" style="display:block;border:0;width:110px;height:auto;"></a>
      <p style="margin:20px 0;{{ font }}font-size:12px;line-height:22px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;">
        {%- for link in [
            {url: appUrl ~ '/dashboard', label: 'My dog'|trans},
            {url: appUrl ~ '/chat', label: 'Coach'|trans},
            {url: appUrl ~ '/courses', label: 'Courses'|trans},
            {url: appUrl ~ '/account', label: 'My account'|trans},
        ] -%}
          <a href="{{ link.url }}" style="color:#ffffff;text-decoration:none;white-space:nowrap;">{{ link.label }}</a>{% if not loop.last %}&nbsp;&nbsp;&middot;&nbsp;&nbsp;{% endif %}
        {%- endfor -%}
      </p>
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td style="border-top:1px solid #6b7d69;padding-top:20px;{{ font }}font-size:12px;line-height:18px;color:#ffffff;">
        <p style="margin:0 0 6px;">&copy; {{ 'now'|date('Y') }} ZENOO &middot; <a href="mailto:support@myzenoo.com" style="color:#ffffff;">support@myzenoo.com</a></p>
        <p style="margin:0;">{{ 'You’re getting this email because of your ZENOO account at'|trans }} <a href="{{ appUrl }}" style="color:#ffffff;">{{ site }}</a>.</p>
        {% block unsubscribe %}{% endblock %}
      </td></tr></table>
    </td></tr>
  </table>
</td></tr>
</table>
</body>
</html>
