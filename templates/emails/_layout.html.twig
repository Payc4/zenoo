{# Shared email layout: table-based with inline styles so it renders in every mail client. #}
<!DOCTYPE html>
<html lang="{{ app.locale }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}ZENOO{% endblock %}</title>
</head>
<body style="margin:0;padding:0;background:#f8f7f2;font-family:Inter,Helvetica,Arial,sans-serif;color:#445942;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f8f7f2;">
<tr><td align="center" style="padding:24px 12px;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;">
    <tr><td align="center" style="background:#445942;border-radius:24px 24px 0 0;padding:22px 24px;">
      <a href="{{ appUrl }}"><img src="{{ appUrl }}/images/logo-white.png" width="110" alt="ZENOO" style="display:block;border:0;height:auto;"></a>
    </td></tr>
    <tr><td style="background:#ffffff;border-radius:0 0 24px 24px;padding:32px 28px;font-size:16px;line-height:1.5;color:#445942;">
      {% block content %}{% endblock %}
      <p style="margin:28px 0 0;">{{ 'Warm regards,'|trans }}<br>{{ 'ZENOO team'|trans }}</p>
    </td></tr>
    <tr><td align="center" style="padding:18px 12px;font-size:12px;line-height:1.5;color:#7c8a7b;">
      <strong style="color:#f7a223;letter-spacing:.04em;">{{ 'REAL FOOD. HEALTHY PET.'|trans }}</strong><br>
      {{ 'You’re getting this email because of your ZENOO account at'|trans }} <a href="{{ appUrl }}" style="color:#7c8a7b;">{{ appUrl|replace({'https://': '', 'http://': ''}) }}</a>.
    </td></tr>
  </table>
</td></tr>
</table>
</body>
</html>
