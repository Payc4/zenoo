{% extends 'emails/_layout.html.twig' %}
{% import 'emails/_ui.html.twig' as ui %}
{% block title %}{{ 'Welcome to ZENOO'|trans }}{% endblock %}
{% block content %}
{{ ui.eyebrow('My account'|trans) }}
{{ ui.h1('Welcome, %name%!'|trans({'%name%': user.displayName})) }}
{{ ui.p('Your ZENOO account is ready. From now on you can see your orders and update your details in one place.'|trans) }}
{{ ui.p('Not sure if your dog’s bowl is on track? The free Bowl Score quiz takes about three minutes.'|trans) }}
{{ ui.button(appUrl ~ '/quiz/', 'Take the Bowl Score quiz'|trans) }}
<p style="margin:0;font-family:Inter,Arial,Helvetica,sans-serif;font-size:15px;line-height:22px;color:#5a6b59;">{{ 'Log in any time at %link% with %email%.'|trans({'%link%': '<a href="' ~ appUrl ~ '/login" style="color:#445942;font-weight:700;">' ~ (appUrl|replace({'https://': '', 'http://': ''})|e) ~ '/login</a>', '%email%': user.email|e})|raw }}</p>
{% endblock %}
