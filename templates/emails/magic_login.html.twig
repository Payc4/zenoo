{% extends 'emails/_layout.html.twig' %}
{% import 'emails/_ui.html.twig' as ui %}
{% block title %}{{ 'Your login link'|trans }}{% endblock %}
{% block content %}
{{ ui.eyebrow('My account'|trans) }}
{{ ui.h1('Your login link'|trans) }}
{{ ui.p('Hi %name%, tap the button to log in to ZENOO. No password needed.'|trans({'%name%': user.displayName})) }}
{{ ui.button(loginUrl, 'Log me in'|trans) }}
{{ ui.small('The link works once, for 10 minutes. If you didn’t ask for it, you can ignore this email.'|trans) }}
{{ ui.small('Button not working? Copy this link:'|trans ~ ' ' ~ loginUrl) }}
{% endblock %}
