{% extends 'emails/_layout.html.twig' %}
{% import 'emails/_ui.html.twig' as ui %}
{% block title %}{{ 'Reset your password'|trans }}{% endblock %}
{% block content %}
{{ ui.eyebrow('My account'|trans) }}
{{ ui.h1('Reset your password'|trans) }}
{{ ui.p('Hi %name%, someone asked to reset the password for your ZENOO account. If it was you, choose a new one here:'|trans({'%name%': user.displayName})) }}
{{ ui.button(resetUrl, 'Choose a new password'|trans) }}
{{ ui.small('The link works for one hour. If you didn’t ask for this, you can ignore this email: your password stays the same.'|trans) }}
{{ ui.small('Button not working? Copy this link:'|trans ~ ' ' ~ resetUrl) }}
{% endblock %}
