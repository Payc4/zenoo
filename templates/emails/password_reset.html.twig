{% extends 'emails/_layout.html.twig' %}
{% block title %}Reset your password{% endblock %}
{% block content %}
<h1 style="font-family:'Inter Tight',Inter,Helvetica,Arial,sans-serif;font-weight:800;font-size:26px;line-height:1.15;text-transform:uppercase;margin:0 0 14px;color:#445942;">Reset your password</h1>
<p style="margin:0 0 12px;">Hi {{ user.displayName }}, someone asked to reset the password for your ZENOO account. If it was you, choose a new one here:</p>
{{ include('emails/_button.html.twig', {url: resetUrl, label: 'Choose a new password'}) }}
<p style="margin:0 0 12px;font-size:14px;">The link works for one hour. If you didn’t ask for this, you can ignore this email: your password stays the same.</p>
<p style="margin:0;font-size:12px;color:#7c8a7b;word-break:break-all;">Button not working? Copy this link: {{ resetUrl }}</p>
{% endblock %}
