{% extends 'emails/_layout.html.twig' %}
{% import 'emails/_ui.html.twig' as ui %}
{% block title %}{{ 'Confirm your email'|trans }}{% endblock %}
{% block content %}
{{ ui.stat(score ~ '/100', dogName ~ ' · ' ~ 'Bowl Score'|trans) }}
{{ ui.h1('Confirm your email'|trans) }}
{{ ui.p(firstName ? 'Hi %name%,'|trans({'%name%': firstName}) : 'Hi,'|trans) }}
{{ ui.p('Thanks for taking the ZENOO quiz. Confirm your email and we’ll create your free ZENOO account with %dog%’s profile, so you can come back to the score, the daily plan and lessons picked for %dog% any time.'|trans({'%dog%': dogName})) }}
{{ ui.button(confirmUrl, 'Confirm and open %dog%’s dashboard'|trans({'%dog%': dogName})) }}
{{ ui.small('The link works for 7 days. If you didn’t take the quiz, you can ignore this email and nothing will be created.'|trans) }}
{{ ui.small('Button not working? Copy this link:'|trans ~ ' ' ~ confirmUrl) }}
{% endblock %}
