{% extends 'emails/_layout.html.twig' %}
{% import 'emails/_ui.html.twig' as ui %}
{% block title %}{{ 'How is %dog% doing?'|trans({'%dog%': dogName}) }}{% endblock %}
{% block content %}
{{ ui.eyebrow(dogName ~ ' · ' ~ 'Coach'|trans) }}
{{ ui.h1('How is %dog% doing?'|trans({'%dog%': dogName})) }}
{{ ui.p(user.firstName ? 'Hi %name%,'|trans({'%name%': user.firstName}) : 'Hi,'|trans) }}
{{ ui.p('Your ZENOO coach wanted to check in:'|trans, true) }}
{% endblock %}
{% block band %}<p style="margin:0;font-family:Inter,Arial,Helvetica,sans-serif;font-size:18px;line-height:26px;font-weight:700;color:#445942;">{{ question }}</p>{% endblock %}
{% block after %}
{{ ui.button(chatUrl, 'Answer in the chat'|trans) }}
{{ ui.p('Your answer helps the coach keep the advice right for your dog.'|trans, true) }}
{% endblock %}
{% block unsubscribe %}<p style="margin:6px 0 0;"><a href="{{ offUrl }}" style="color:#ffffff;text-decoration:underline;">{{ 'Don’t want these check-ins? Switch them off'|trans }}</a></p>{% endblock %}
