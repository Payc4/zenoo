{% extends 'base.html.twig' %}

{% block title %}{{ 'Courses'|trans }} · ZENOO{% endblock %}
{% block robots %}<meta name="robots" content="noindex">{% endblock %}
{% block importmap %}{{ importmap(['app', 'courses']) }}{% endblock %}

{% block body %}
<section class="section">
  <div class="wrap cl-wrap">
    <header class="cl-head">
      <div>
        <p class="kicker">{{ 'Courses'|trans }}</p>
        <h1 class="cl-title">{{ 'A few minutes a day for a healthier dog.'|trans }}</h1>
      </div>
      {% if streak %}<p class="cl-streak">🔥 <strong>{{ streak }}</strong> {{ 'day streak'|trans }}</p>{% endif %}
    </header>

    {% if picks %}
      <section class="cl-picks" aria-labelledby="picks-h">
        <h2 id="picks-h">{{ 'Picked for %dog%'|trans({'%dog%': dog.name}) }}</h2>
        <ol class="dash-lessons">
          {% for p in picks %}
            {% set c = items[0].course %}
            {% set isLocked = p.lesson.id in items[0].locked %}
            <li class="card dash-lesson">
              <span class="dash-lesson__n">{{ isLocked ? '🔒' : p.number }}</span>
              <div>
                <h3><a href="{{ isLocked ? '#unlock' : path('app_course_lesson', {slug: c.slug, id: p.lesson.id}) }}">{{ p.lesson.title }}</a></h3>
                <p class="small">{{ p.reason|trans }}{% if p.lesson.durationMinutes %} · {{ '%n% min'|trans({'%n%': p.lesson.durationMinutes}) }}{% endif %}</p>
              </div>
            </li>
          {% endfor %}
        </ol>
      </section>
    {% endif %}

    {% if unlock %}
      {# One payment opens every locked lesson (admin: Products → "Unlocks locked lessons"). #}
      <section class="cl-unlock" id="unlock">
        <div>
          <h2 class="cl-unlock__title">🔒 {{ 'Unlock all lessons'|trans }}</h2>
          <p>{{ 'One payment opens every locked lesson, for good.'|trans }}{% if unlockCancelled %} {{ 'The payment was cancelled, nothing was charged.'|trans }}{% endif %}</p>
        </div>
        <form method="post" action="{{ path('app_checkout', {slug: unlock.slug}) }}">
          <input type="hidden" name="_csrf_token" value="{{ csrf_token('checkout-' ~ unlock.slug) }}">
          <button type="submit" class="btn">{{ 'Unlock for €%price%'|trans({'%price%': unlock.price|number_format(2, '.', ',')}) }}</button>
        </form>
      </section>
    {% endif %}

    {% for item in items %}
      {% set c = item.course %}
      <section class="cl-course" lang="{{ c.locale }}">
        <div class="cl-course__top">
          <div>
            <h2 class="cl-course__title">{{ c.title }}{% if not c.published %} <span class="cl-tag">{{ 'Draft'|trans }}</span>{% endif %}{% if c.locale != 'en' %} <span class="cl-tag cl-tag--lang">{{ locale_name(c.locale) }}</span>{% endif %}</h2>
            {% if c.description %}<p class="cl-course__desc">{{ c.description }}</p>{% endif %}
          </div>
          <div class="cl-course__count">{{ item.done }} / {{ item.lessons|length }}<small>{{ 'lessons done'|trans }}</small></div>
        </div>
        <div class="cl-bar"><span style="width: {{ item.lessons|length ? (item.done / item.lessons|length * 100)|round : 0 }}%"></span></div>

          {% if item.next %}
            <a class="cl-continue" href="{{ item.next.id in item.locked ? '#unlock' : path('app_course_lesson', {slug: c.slug, id: item.next.id}) }}">
              <span><small>{{ item.progress[item.next.id] is defined ? 'Continue'|trans : 'Up next'|trans }}</small>{{ item.next.title }}</span>
              <span class="cl-continue__go" aria-hidden="true">▶</span>
            </a>
          {% endif %}
          <ol class="cl-lessons">
            {% for l in item.lessons %}
              {% set p = item.progress[l.id] ?? null %}
              {% set isLocked = l.id in item.locked %}
              <li class="cl-lesson{% if p and p.completed %} is-done{% endif %}{% if isLocked %} is-locked{% endif %}">
                <a href="{{ isLocked ? '#unlock' : path('app_course_lesson', {slug: c.slug, id: l.id}) }}"{% if isLocked %} aria-label="{{ l.title }}: {{ 'locked'|trans }}"{% endif %}>
                  <span class="cl-lesson__n">{% if isLocked %}🔒{% elseif p and p.completed %}✓{% else %}{{ loop.index }}{% endif %}</span>
                  <span class="cl-lesson__t">{{ l.title }}{% if not l.published %} <span class="cl-tag">{{ 'Draft'|trans }}</span>{% endif %}
                    <small>{% if l.subtitle %}{{ l.subtitle }} · {% endif %}{% if l.durationMinutes %}{{ '%n% min'|trans({'%n%': l.durationMinutes}) }}{% else %}{{ '%n% screens'|trans({'%n%': l.slideCount}) }}{% endif %}{% if p and not p.completed %} · {{ p.percent }}%{% endif %}</small></span>
                </a>
              </li>
            {% endfor %}
          </ol>
      </section>
    {% else %}
      <div class="cl-empty">
        <p class="kicker">{{ 'Coming soon'|trans }}</p>
        <h2 class="cl-title">{{ 'Courses are on their way.'|trans }}</h2>
        <p>{% if is_granted('ROLE_ADMIN') %}{{ 'Create the first one in the <a href="%url%">Course studio</a>.'|trans({'%url%': path('admin_course_studio')})|raw }}{% else %}{{ 'Check back soon.'|trans }}{% endif %}</p>
      </div>
    {% endfor %}
  </div>
</section>
{% endblock %}
