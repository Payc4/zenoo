{% extends 'base.html.twig' %}

{% block title %}{{ 'Chat'|trans }} · ZENOO{% endblock %}
{% block robots %}<meta name="robots" content="noindex">{% endblock %}
{% block body_class %}chat-page{% endblock %}
{% block importmap %}{{ importmap(['app', 'chat']) }}{% endblock %}
{% block footer %}{% endblock %}

{% block body %}
<div class="chat-app" id="chat"
     data-send-url="{{ path('app_chat_send') }}"
     data-checkin-url="{{ path('app_chat_checkin') }}"
     data-csrf="{{ csrf_token('chat') }}"
     data-max-chars="{{ maxChars }}"
     data-max-files="{{ maxFiles }}"
     data-attach-hint="{{ attachHint ? 'true' : 'false' }}"
     data-configured="{{ configured ? 'true' : 'false' }}"
     data-limit="{{ limit }}"
     data-reset-label="{{ resetLabel|trans }}"
     data-i18n="{{ {
        limitAll: 'You’ve used all %limit% messages for today. You can chat again after %time%.'|trans({'%limit%': limit, '%time%': resetLabel|trans}),
        error: 'Something went wrong. Please try again.'|trans,
        noReply: 'No reply came back. Please try again.'|trans,
        answerQuestions: 'Answer the questions'|trans,
        askAnything: 'Ask anything about feeding your dog or using ZENOO.'|trans,
        prevQ: 'Previous question'|trans,
        nextQ: 'Next question'|trans,
        closeQ: 'Close the questions'|trans,
        count: '%n% of %total%'|trans,
        ownAnswer: 'Your own answer'|trans,
        typeAnswer: 'Type your answer…'|trans,
        skip: 'Skip'|trans,
        sendAnswers: 'Send answers'|trans,
        next: 'Next →'|trans,
        skipped: 'skipped'|trans,
        aboutDog: 'A bit about my dog:'|trans,
        checkin: 'Quick check-in'|trans,
        saveAnswers: 'Save'|trans,
        removeFile: 'Remove'|trans,
        tooManyFiles: 'You can send up to %n% files at a time.'|trans({'%n%': maxFiles}),
        badFile: 'Please send a photo (JPG, PNG, WebP) or a PDF.'|trans,
        pdfTooBig: 'That file is too large. PDFs can be up to 8 MB.'|trans,
        photoAlt: 'Photo you sent'|trans,
        sending: 'Sending…'|trans,
     }|json_encode }}">

    <section class="chat-main">
        <div class="chat-bar">
            <span class="chat-bar__title">{{ 'Chat with ZENOO'|trans }}</span>
            {% if unlimited %}
                <span class="chat-quota">{{ 'Admin: no daily limit'|trans }}</span>
            {% else %}
                <span class="chat-quota" title="{{ 'Resets at %time%'|trans({'%time%': resetLabel|trans}) }}">{{ '<strong id="chat-remaining">%remaining%</strong> of %limit% messages left today'|trans({'%remaining%': remaining, '%limit%': limit})|raw }}</span>
            {% endif %}
            {% if messages|length %}
                <form method="post" action="{{ path('app_chat_clear') }}" data-confirm="{{ 'Clear your whole chat history? This can’t be undone.'|trans }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('chat-clear') }}">
                    <button type="submit" class="link-btn small">{{ 'Clear chat'|trans }}</button>
                </form>
            {% endif %}
        </div>

        {% if not configured %}
            <div class="flash flash-info chat-alert" role="status">
                {% if is_granted('ROLE_ADMIN') %}
                    {{ 'Admin: add <code>ANTHROPIC_API_KEY</code> to the environment variables in Coolify and redeploy to switch the chat on.'|trans|raw }}
                {% else %}
                    {{ 'The chat isn’t switched on yet. Please check back soon.'|trans }}
                {% endif %}
            </div>
        {% endif %}

        <div class="chat-scroll" id="chat-scroll">
            <div class="chat-thread" id="chat-thread">
                {% if messages|length == 0 %}
                    <div class="chat-empty" id="chat-empty">
                        <img src="/apple-touch-icon.png" alt="" width="56" height="56">
                        <h1>{{ 'Hi %name%, how can we help?'|trans({'%name%': app.user.displayName}) }}</h1>
                        {% if needsFood and configured %}
                            {# First step after sign-up: what the dog eats, from a label photo or by name. #}
                            <div class="chat-onboard" id="chat-onboard">
                                <p class="chat-onboard__title">{{ 'Let’s start with what %dog% eats.'|trans({'%dog%': dog.name}) }}</p>
                                <p class="chat-muted">{{ 'Snap a photo of the food label (or a screenshot from the shop), or just type the food’s name. I’ll check it and tell you how it fits %dog%.'|trans({'%dog%': dog.name}) }}</p>
                                <button type="button" class="btn chat-onboard__btn" data-attach>{{ '📷 Snap the food label'|trans }}</button>
                            </div>
                        {% endif %}
                        {% if cardsAreIntro and configured %}
                            <p class="chat-muted" id="chat-intro-note">{{ 'A few quick questions first, so the tips fit your dog. You can skip any of them.'|trans }}</p>
                        {% else %}
                            <p class="chat-muted">{{ 'Ask anything about feeding your dog or using ZENOO.'|trans }}</p>
                        {% endif %}
                        <div class="chat-suggest" id="chat-suggest" {{ (cardsAreIntro or needsFood) and configured ? 'hidden' }}>
                            {% for s in [
                                'How much should my dog eat a day?',
                                'How do I switch my dog to a new food?',
                                'My dog is a picky eater. Any tips?',
                                'How do I read a dog food label?'
                            ] %}
                                <button type="button" class="chat-suggest__btn" data-suggest="{{ s|trans }}" {{ configured and (unlimited or remaining > 0) ? '' : 'disabled' }}>{{ s|trans }}</button>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}

                {% for m in messages %}
                    {% if m.fromUser %}
                        <div class="chat-msg chat-msg--user">
                            {% if m.attachments %}
                                <div class="chat-files">
                                    {% for a in m.attachments %}
                                        {% set url = path('app_chat_file', {id: m.id, index: loop.index0}) %}
                                        {% if a.type == 'application/pdf' %}
                                            <a class="chat-file chat-file--pdf" href="{{ url }}" target="_blank" rel="noopener">📄 {{ a.name }}</a>
                                        {% else %}
                                            <a class="chat-file" href="{{ url }}" target="_blank" rel="noopener"><img src="{{ url }}" alt="{{ 'Photo you sent'|trans }}" loading="lazy"></a>
                                        {% endif %}
                                    {% endfor %}
                                </div>
                            {% endif %}
                            {% if m.content %}<div class="chat-bubble">{{ m.content|nl2br }}</div>{% endif %}
                        </div>
                    {% else %}
                        <div class="chat-msg chat-msg--bot">
                            <img class="chat-avatar" src="/favicon.png" alt="" width="32" height="32">
                            <div class="chat-answer">
                                {{ m.content ? m.content|chat_markdown : '<p>' ~ ('I have a few quick questions for you.'|trans|e) ~ '</p>' }}
                                {% if m.questions %}
                                    <ol class="chat-asked">{% for q in m.questions %}<li>{{ q.question }}</li>{% endfor %}</ol>
                                    {% if loop.last %}<button type="button" class="btn btn-small chat-reopen" data-reopen hidden>{{ 'Answer the questions'|trans }}</button>{% endif %}
                                {% endif %}
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        </div>

        <div class="qcard" id="chat-qcard" role="dialog" aria-modal="false" aria-labelledby="qcard-question" hidden></div>
        {% if cards and configured %}
            <script type="application/json" id="chat-cards">{{ {questions: cards, intro: cardsAreIntro}|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }}</script>
        {% endif %}
        {% if checkin %}
            <script type="application/json" id="chat-checkin">{{ checkin|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }}</script>
        {% endif %}

        <form class="chat-composer" id="chat-form">
            <div class="chat-pending" id="chat-pending" hidden></div>
            <div class="chat-composer__box">
                <input type="file" id="chat-file" accept="image/*,application/pdf" multiple hidden>
                <button type="button" class="chat-attach" id="chat-attach" data-attach aria-label="{{ 'Add a photo or PDF'|trans }}" title="{{ 'Add a photo or PDF'|trans }}" {{ configured and (unlimited or remaining > 0) ? '' : 'disabled' }}>
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3v11H4z"/><circle cx="12" cy="13" r="3.5"/></svg>
                </button>
                <label for="chat-input" class="visually-hidden">{{ 'Your message'|trans }}</label>
                <textarea id="chat-input" rows="1" maxlength="{{ maxChars }}" placeholder="{{ (attachHint ? 'Describe what you see and add a photo…' : 'Ask about your dog’s food…')|trans }}"
                          {{ configured and (unlimited or remaining > 0) ? '' : 'disabled' }}>{{ ask }}</textarea>
                <button type="submit" class="chat-send" id="chat-send" aria-label="{{ 'Send'|trans }}" {{ configured and (unlimited or remaining > 0) ? '' : 'disabled' }}>
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
                </button>
            </div>
            <p class="chat-composer__meta">
                <span id="chat-limit-note">{% if not unlimited and remaining == 0 %}{{ 'You’ve used all %limit% messages for today. You can chat again after %time%.'|trans({'%limit%': limit, '%time%': resetLabel|trans}) }}{% else %}{{ 'The assistant can make mistakes. For health questions, please ask your vet.'|trans }}{% endif %}</span>
                <span id="chat-counter"></span>
            </p>
        </form>
    </section>
</div>
{% endblock %}
