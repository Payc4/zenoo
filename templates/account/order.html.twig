{% extends 'base.html.twig' %}

{% block title %}{{ 'Order #%id%'|trans({'%id%': purchase.id}) }} · ZENOO{% endblock %}
{% block robots %}<meta name="robots" content="noindex">{% endblock %}

{% block body %}
<section class="section">
    <div class="wrap">
        <div class="receipt">
            <p class="small"><a href="{{ path('app_account') }}#orders">{{ '← My orders'|trans }}</a></p>
            <div class="card">
                {% if purchase.completed %}<div class="check-badge" aria-hidden="true">✓</div>{% endif %}
                <p class="kicker">{{ 'Order #%id%'|trans({'%id%': purchase.id}) }}</p>
                <h1 style="font-size:clamp(28px,4vw,40px)">{{ purchase.product.name }}</h1>
                {% if purchase.testMode %}
                    <p><span class="tag tag-test">{{ 'Test order'|trans }}</span> <span class="small muted">{{ 'Paid in Stripe test mode. No real money was taken.'|trans }}</span></p>
                {% endif %}
                <dl>
                    <dt>{{ 'Date'|trans }}</dt><dd>{{ purchase.createdAt|local_date('datetime') }}</dd>
                    <dt>{{ 'Status'|trans }}</dt><dd>{{ purchase.completed ? 'Paid'|trans : 'Refunded'|trans }}</dd>
                    {% if purchase.discountAmount %}<dt>{{ 'Discount'|trans }}</dt><dd>−€{{ purchase.discountAmount|number_format(2, '.', ',') }}</dd>{% endif %}
                    <dt>{{ 'Total'|trans }}</dt><dd>€{{ purchase.amount|number_format(2, '.', ',') }}</dd>
                    <dt>{{ 'Payment reference'|trans }}</dt><dd>{{ purchase.stripePaymentIntentId ?: purchase.stripeSessionId }}</dd>
                </dl>
                <div class="btn-row" style="margin-top:24px">
                    <a class="btn" href="{{ path('app_shop') }}">{{ 'Back to the shop'|trans }}</a>
                    <a class="btn btn-outline" href="{{ path('app_quiz') }}">{{ 'Take the Bowl Score quiz'|trans }}</a>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
