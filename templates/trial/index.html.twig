{% extends 'base.html.twig' %}

{# The paywall (TrialController::index): the Bowl Score is free, the rest opens with the free trial. #}
{% block title %}{{ 'Start your free month'|trans }} · ZENOO{% endblock %}
{% block importmap %}{{ importmap(['app', 'dashboard']) }}{% endblock %}

{% block body %}
<section class="today-head trial-head">
  <div class="wrap">
    {% if dog %}
      <p class="kicker">{{ 'Bowl Score'|trans }}</p>
      <h1>{{ lapsed ? 'Your free month has ended'|trans : 'Your plan for %dog% is ready'|trans({'%dog%': dog.name}) }}</h1>
      <div class="today-score">
        <span class="today-score__ring" style="--p: {{ dog.bowlScore }}"><span>{{ dog.bowlScore }}</span></span>
        <span><strong>{{ 'Bowl Score'|trans }}{% if dog.get('score_title') %}: {{ dog_text(dog, 'score_title')|lower }}{% endif %}</strong></span>
      </div>
    {% else %}
      <h1>{{ lapsed ? 'Your free month has ended'|trans : 'Start your free month'|trans }}</h1>
    {% endif %}
  </div>
</section>

<div class="wrap today trial">
  {# The recommendations exist; they show once the trial starts. #}
  {% if dog %}
    <section class="card trial-locked" aria-labelledby="locked-h">
      <h2 id="locked-h">{{ 'What we’d change first for %dog%'|trans({'%dog%': dog.name}) }}</h2>
      <ol class="trial-locked__list" aria-hidden="true">
        {% for i in 1..3 %}<li><span class="trial-locked__n">{{ i }}</span><span class="trial-locked__blur">{{ ['Weigh the food for two weeks and adjust by ten percent', 'Count treats into the daily amount', 'Change one thing in the bowl and watch the stool'][i - 1]|trans }}</span></li>{% endfor %}
      </ol>
      <p class="trial-locked__note">🔒 {{ lapsed ? 'Your recommendations, daily plan and lessons open again with the plan.'|trans : 'Your recommendations, daily plan and lessons open with the free month.'|trans }}</p>
    </section>
  {% endif %}

  <section class="card trial-offer" aria-labelledby="offer-h">
    {% if badge and not lapsed %}<p class="trial-badge">{{ 'Cyber Monday Special'|trans }}</p>{% endif %}
    {# Only the first plan has the free month (Subscriptions::trialUsed). #}
    <h2 id="offer-h">{{ lapsed ? 'Restart your plan'|trans : 'One month free'|trans }}</h2>
    <ul class="trial-list">
      <li>{{ 'Recommendations and a daily plan for your dog'|trans }}</li>
      <li>{{ 'A coach that knows your dog, any time'|trans }}</li>
      <li>{{ '30 short lessons on feeding'|trans }}</li>
      <li>{{ 'A log for weight, stool and itching, and a report for your vet'|trans }}</li>
    </ul>
    <form method="post" action="{{ path('app_trial_start') }}">
      <input type="hidden" name="_token" value="{{ csrf_token('trial') }}">
      <button class="btn btn-block btn-sun" type="submit">{{ lapsed ? 'Start my plan'|trans : 'Start free trial'|trans }}</button>
    </form>
    <p class="small muted trial-terms">
      {% if lapsed %}
        {% if price %}{{ '€%price% a month from today. Cancel any time in your account.'|trans({'%price%': price|number_format(2, decimal_sep(), ' ')}) }}
        {% else %}{{ 'A monthly plan from today. Cancel any time in your account.'|trans }}{% endif %}
      {% else %}
        {% if price %}{{ 'Free for %days% days, then €%price% a month. Cancel any time in your account.'|trans({'%days%': days, '%price%': price|number_format(2, decimal_sep(), ' ')}) }}
        {% else %}{{ 'Free for %days% days, then a monthly plan. Cancel any time in your account.'|trans({'%days%': days}) }}{% endif %}
        {{ 'A card is needed to start; nothing is charged during the free month.'|trans }}
      {% endif %}
    </p>
  </section>

  <p class="small muted"><a href="{{ path('app_account') }}">{{ 'My account'|trans }}</a> · <a href="{{ path('app_logout') }}">{{ 'Log out'|trans }}</a></p>
</div>
{% endblock %}
