# Committed defaults. NEVER put real secrets in this file.
# Production values are set in Coolify's environment; for local overrides use .env.local (git-ignored).

###> symfony/framework-bundle ###
APP_ENV=prod
APP_SECRET=
###< symfony/framework-bundle ###

# This deployment's own public URL, used in email links and Stripe redirects.
APP_URL=http://localhost:8000

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/zenoo?serverVersion=8.0.32&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
# Amazon SES in production, e.g. ses+api://ACCESS_KEY:SECRET_KEY@default?region=eu-west-1
MAILER_DSN=null://null
MAIL_FROM_EMAIL=noreply@myzenoo.com
###< symfony/mailer ###

SESSION_DSN=file:///%kernel.project_dir%/var/sessions
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR

# Cloudflare Turnstile (captcha on sign-up). Leave empty to switch the captcha off.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Stripe. Checkout stays switched off until BOTH are set. Use sk_test_... keys for the test product.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Bowl Score quiz → Klaviyo. ON: every finished quiz subscribes that email to the LIVE
# "Dog Quiz – EN" flow and sends it a real email. Set to false in .env.local to test without sending.
KLAVIYO_COMPANY_ID=SVCcfJ
KLAVIYO_LIST_ID=Xubzza
# Lithuanian quiz (zenoo.lt): its own Klaviyo account and list. Empty = LT quiz results are not
# sent to Klaviyo (the site's own confirmation email still goes out).
KLAVIYO_LT_COMPANY_ID=
KLAVIYO_LT_LIST_ID=
# Server-side Klaviyo key (private, "Profiles: Full access" only). Set = each quiz-taker's personal
# confirmation link is written to their Klaviyo profile as "dashboard_link", for the quiz flow's
# email button {{ person|lookup:'dashboard_link' }}. Never put the real key in this file.
KLAVIYO_PRIVATE_KEY=
KLAVIYO_LT_PRIVATE_KEY=
# false = don't also send the site's own confirmation email (only once the Klaviyo email has the button).
QUIZ_SITE_CONFIRM_EMAIL=true
QUIZ_SEND_TO_KLAVIYO=true

# Chatbot (/chat, logged-in pet parents only). Empty ANTHROPIC_API_KEY = chat switched off.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# Messages per pet parent per day (admins are not limited), and the timezone the day resets in.
CHAT_DAILY_LIMIT=60
CHAT_TIMEZONE=Europe/Vilnius
